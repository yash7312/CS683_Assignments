#include "cache.h"
#include <cstring>

/* ==================================================================================
   STRIDE PATTERN PREFETCHER (SPP) -- L1D, per-IP, dual mode (uniform + non-uniform)
   ------------------------------------------------------------------------------
   Every #define below is a CONFIGURABLE knob; the storage report printed at the
   end of simulation is computed from these same numbers, so it always matches
   the code that actually ran.

   Requirement -> code-section map (see inline [REQ-n] / [HINT-n] tags below):
     [REQ-1] IP-indexed tracking table                  -> class IPTracker, trackers[]
     [REQ-2] Dual pattern classification                 -> uniform_conf + Pattern Table (PT)
     [REQ-3] Uniform prioritized, dynamic fallback        -> per-prefetch arbitration loop in operate()
     [REQ-4] Signature -> next-stride mapping             -> compute_signature() / PT
     [REQ-5] Degree > 1                                   -> same loop, up to current_degree steps
     [REQ-6] Accuracy-based throttling                    -> pf_filter[] + evaluate_accuracy()
     [HINT-1] Confidence counters / state transition       -> uniform_conf, PT confidence
     [HINT-2] Issued/useful counters, dynamic degree       -> epoch_fills / epoch_useful
     [HINT-3] Stay within the same page                    -> page check before every prefetch_line()
     [HINT-4] Lightweight / minimal storage                -> narrow fields, small shared tables

   Simulator facts this file relies on (checked in src/cache.cc):
     * l1d_prefetcher_operate() is called for demand LOADs only (hits and misses)
       and its 'addr' is the VIRTUAL address.
     * l1d_prefetcher_cache_fill() gets BOTH addresses: 'v_addr' is virtual,
       'addr' is PHYSICAL. Anything compared against operate()'s address must
       therefore use v_addr.
     * prefetch_line() returns 0 when the prefetch queue is full (request dropped).
   ================================================================================== */

/* ---------------- [CONFIG] IP tracker table (per-IP history) ---------------- */
#define IP_TRACKER_COUNT        128     // number of tracked IPs
#define IP_TAG_BITS             12      // low IP bits kept as the tracker's identity
#define LINE_ADDR_BITS          16      // low bits of the last cache-line address kept per IP
#define DELTA_BITS              7       // signed stride in cache lines: -64 .. +63
                                        //   (a 4 KB page holds 64 lines, so a larger stride
                                        //    can never produce a same-page prefetch anyway)

/* ---------------- [CONFIG] Uniform (constant-stride) detector --------------- */
#define UNIFORM_CONF_BITS        2      // saturating counter width
#define UNIFORM_CONF_MAX         ((1 << UNIFORM_CONF_BITS) - 1)
#define UNIFORM_CONF_THRESH      1      // confidence needed before uniform mode is trusted
#define UNIFORM_RESET_ON_BREAK   1      // 1: a different stride clears the counter (the run is broken)
                                        // 0: a different stride only decrements it

/* ---------------- [CONFIG] Non-uniform (signature) detector ----------------- */
#define SIG_HIST_LEN             3      // window depth W: number of recent strides forming a signature
#define PT_SIZE                  64     // shared Pattern Table entries (power of 2)
#define PT_TAG_BITS              8      // tag kept per PT entry to detect aliasing
#define PT_CONF_BITS             2      // saturating counter width
#define PT_CONF_MAX              ((1 << PT_CONF_BITS) - 1)
#define NONUNIFORM_CONF_THRESH   2      // PT confidence needed for the first predicted stride
#define CHAIN_CONF_THRESH        PT_CONF_MAX   // confidence needed for every further (speculative) hop

/* ---------------- [CONFIG] Prefetch degree and accuracy throttling ---------- */
#define MAX_PREFETCH_DEGREE      4
#define MIN_PREFETCH_DEGREE      1
#define BASE_PREFETCH_DEGREE     2      // degree used until the first accuracy measurement
#define PF_TRACK_SIZE            64     // "lines we prefetched and nobody used yet" filter (power of 2)
#define PF_TAG_BITS              10     // partial tag per filter entry
#define ACC_EVAL_WINDOW          256    // prefetch fills per accuracy epoch
#define ACC_HIGH_PCT             75     // accuracy >= HIGH            -> degree 4
#define ACC_MID_PCT              50     // MID  <= accuracy < HIGH     -> degree 3
#define ACC_LOW_PCT              25     // LOW  <= accuracy < MID      -> degree 2
                                        //         accuracy < LOW      -> degree 1

/* ================================================================================== */

#define DELTA_MAX   ((1 << (DELTA_BITS - 1)) - 1)       // +63
#define DELTA_MIN   (-(1 << (DELTA_BITS - 1)))          // -64
#define LINE_MASK   ((1u << LINE_ADDR_BITS) - 1)

// [REQ-1] Per-IP tracker. The comment on each field is the number of bits a hardware
// implementation needs; the C++ type is only the nearest container.
class IPTracker {
  public:
    bool     valid;                      // 1 bit
    uint16_t ip_tag;                     // IP_TAG_BITS
    uint16_t last_line;                  // LINE_ADDR_BITS: low bits of the last line this IP touched
    int8_t   last_stride;                // DELTA_BITS
    uint8_t  uniform_conf;               // UNIFORM_CONF_BITS  [HINT-1]
    int8_t   delta_hist[SIG_HIST_LEN];   // SIG_HIST_LEN * DELTA_BITS: last W strides (the signature)
    uint8_t  hist_count;                 // log2(SIG_HIST_LEN+1) bits: how many of them are valid
    uint8_t  lru;                        // log2(IP_TRACKER_COUNT) bits

    IPTracker() { reset(); }
    void reset() {
        valid = false; ip_tag = 0; last_line = 0; last_stride = 0;
        uniform_conf = 0; hist_count = 0; lru = 0;
        memset(delta_hist, 0, sizeof(delta_hist));
    }
};

// [REQ-4] Shared Pattern Table entry: signature -> predicted next stride
class PTEntry {
  public:
    bool     valid;                      // 1 bit
    uint16_t tag;                        // PT_TAG_BITS
    int8_t   predicted_delta;            // DELTA_BITS
    uint8_t  confidence;                 // PT_CONF_BITS  [HINT-1]
    PTEntry() : valid(false), tag(0), predicted_delta(0), confidence(0) {}
};

// [REQ-6] Filter entry: one line that our prefetch brought into L1D and that no
// demand load has used yet.
struct PFFilterEntry {
    bool     valid;                      // 1 bit
    uint16_t tag;                        // PF_TAG_BITS
};

static IPTracker     trackers[IP_TRACKER_COUNT];
static PTEntry       pattern_table[PT_SIZE];
static PFFilterEntry pf_filter[PF_TRACK_SIZE];

// [HINT-2] accuracy bookkeeping for the current epoch + the degree it selects
static uint32_t epoch_fills    = 0;     // prefetched lines that arrived in L1D this epoch
static uint32_t epoch_useful   = 0;     // of our prefetched lines, how many a demand load hit this epoch
static int      current_degree = BASE_PREFETCH_DEGREE;

// statistics only (not hardware state)
static uint64_t stat_fills = 0, stat_useful = 0, stat_requests = 0, stat_dropped = 0;
static uint64_t stat_uniform_pf = 0, stat_nonuniform_pf = 0, stat_epochs = 0;
static uint64_t stat_degree_epochs[MAX_PREFETCH_DEGREE + 1];

/* ---------------------------------- helpers ---------------------------------- */

static int find_tracker(uint16_t ip_tag)
{
    for (int i = 0; i < IP_TRACKER_COUNT; i++)
        if (trackers[i].valid && trackers[i].ip_tag == ip_tag) return i;
    return -1;
}

static void touch_lru(int idx)
{
    for (int i = 0; i < IP_TRACKER_COUNT; i++)
        if (trackers[i].lru < trackers[idx].lru) trackers[i].lru++;
    trackers[idx].lru = 0;
}

static void allocate_tracker(uint16_t ip_tag, uint16_t line)
{
    int victim = 0;
    for (int i = 0; i < IP_TRACKER_COUNT; i++)
        if (trackers[i].lru == IP_TRACKER_COUNT - 1) { victim = i; break; }

    uint8_t old_lru = trackers[victim].lru;
    trackers[victim].reset();
    trackers[victim].lru = old_lru;
    trackers[victim].ip_tag = ip_tag;
    trackers[victim].last_line = line;
    trackers[victim].valid = true;
    touch_lru(victim);
}

// [REQ-4] Signature: the last W strides, each shifted by 3 bits and XOR-ed together
// (so the ORDER of the strides matters), mixed with a few IP bits so that two
// unrelated IPs do not share a Pattern Table entry by accident.
static uint32_t compute_signature(uint16_t ip_tag, const int8_t *hist)
{
    uint32_t sig = 0;
    for (int i = 0; i < SIG_HIST_LEN; i++) {
        uint32_t enc = (uint32_t)hist[i] & ((1u << DELTA_BITS) - 1);
        sig = (sig << 3) ^ enc;
    }
    sig ^= (uint32_t)(ip_tag & 0x3F) << 7;
    return sig;
}

// Index folds ALL signature bits (not only the newest stride); the tag uses a
// different slice so index and tag together identify the signature.
static inline uint32_t pt_index(uint32_t sig) { return (sig ^ (sig >> 6) ^ (sig >> 12)) & (PT_SIZE - 1); }
static inline uint16_t pt_tag(uint32_t sig)   { return (uint16_t)((sig ^ (sig >> 8)) & ((1u << PT_TAG_BITS) - 1)); }

static bool pt_lookup(uint32_t sig, int8_t &pred_delta, uint8_t &conf)
{
    PTEntry &e = pattern_table[pt_index(sig)];
    if (e.valid && e.tag == pt_tag(sig)) {
        pred_delta = e.predicted_delta;
        conf = e.confidence;
        return true;
    }
    return false;
}

// [HINT-1] Train the PT: 'sig' is the signature that was in effect BEFORE this
// access; 'actual_delta' is the stride that really followed it.
static void pt_train(uint32_t sig, int8_t actual_delta)
{
    PTEntry &e = pattern_table[pt_index(sig)];
    uint16_t tag = pt_tag(sig);

    if (!e.valid) {
        e.valid = true; e.tag = tag; e.predicted_delta = actual_delta; e.confidence = 1;
        return;
    }

    if (e.tag != tag) {
        // A different signature maps to this slot. Do not let one stray access
        // evict a trained entry: weaken it first, replace it only once it is at 0.
        if (e.confidence > 0) { e.confidence--; return; }
        e.tag = tag; e.predicted_delta = actual_delta; e.confidence = 1;
        return;
    }

    if (e.predicted_delta == actual_delta) {
        if (e.confidence < PT_CONF_MAX) e.confidence++;
    } else {
        if (e.confidence > 0) e.confidence--;
        if (e.confidence == 0) { e.predicted_delta = actual_delta; e.confidence = 1; }   // relearn
    }
}

/* ---------------- [REQ-6] accuracy checker ---------------- */

static inline uint32_t pf_index(uint64_t line) { return line & (PF_TRACK_SIZE - 1); }
static inline uint16_t pf_tag(uint64_t line)   { return (uint16_t)((line / PF_TRACK_SIZE) & ((1u << PF_TAG_BITS) - 1)); }

// Called from cache_fill when one of our prefetches lands in L1D.
static inline void pf_filter_mark(uint64_t line)
{
    PFFilterEntry &f = pf_filter[pf_index(line)];
    f.valid = true;
    f.tag = pf_tag(line);
}

// Called on every demand load that hits. True (and the mark is cleared, so each
// prefetched line is counted at most once) if the line was brought in by us.
static inline bool pf_filter_check_and_clear(uint64_t line)
{
    PFFilterEntry &f = pf_filter[pf_index(line)];
    if (f.valid && f.tag == pf_tag(line)) { f.valid = false; return true; }
    return false;
}

// [HINT-2] Once per epoch (ACC_EVAL_WINDOW prefetch fills): accuracy = useful / fills
// for THIS epoch only, then pick the degree for the next epoch from the accuracy range.
// Counting fills (not requests) keeps the measurement honest: requests that were
// dropped, or that asked for a line already in the cache, never had a chance to be useful.
static void evaluate_accuracy()
{
    if (epoch_fills < ACC_EVAL_WINDOW) return;

    uint32_t acc_pct = (epoch_useful * 100) / epoch_fills;

    if      (acc_pct >= ACC_HIGH_PCT) current_degree = MAX_PREFETCH_DEGREE;
    else if (acc_pct >= ACC_MID_PCT)  current_degree = 3;
    else if (acc_pct >= ACC_LOW_PCT)  current_degree = 2;
    else                              current_degree = MIN_PREFETCH_DEGREE;

    if (current_degree > MAX_PREFETCH_DEGREE) current_degree = MAX_PREFETCH_DEGREE;
    if (current_degree < MIN_PREFETCH_DEGREE) current_degree = MIN_PREFETCH_DEGREE;

    stat_epochs++;
    stat_degree_epochs[current_degree]++;
    epoch_fills = 0;
    epoch_useful = 0;
}

/* ================================================================================== */

void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (uniform + non-uniform)" << std::endl;

    for (int i = 0; i < IP_TRACKER_COUNT; i++) {
        trackers[i].reset();
        trackers[i].lru = i;
    }
    for (int i = 0; i < PT_SIZE; i++)
        pattern_table[i] = PTEntry();
    for (int i = 0; i < PF_TRACK_SIZE; i++) {
        pf_filter[i].valid = false;
        pf_filter[i].tag = 0;
    }

    epoch_fills = 0;
    epoch_useful = 0;
    current_degree = BASE_PREFETCH_DEGREE;
    memset(stat_degree_epochs, 0, sizeof(stat_degree_epochs));
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;                 // virtual cache-line address
    uint16_t ip_tag  = (uint16_t)(ip & ((1u << IP_TAG_BITS) - 1));
    uint16_t line    = (uint16_t)(cl_addr & LINE_MASK);

    // [REQ-6] Usefulness: did this demand load hit a line that our prefetch brought in?
    if (cache_hit && pf_filter_check_and_clear(cl_addr)) {
        epoch_useful++;
        stat_useful++;
    }

    // [REQ-1] Find or allocate this IP's tracker
    int index = find_tracker(ip_tag);
    if (index == -1) {
        allocate_tracker(ip_tag, line);
        return;   // first sighting of this IP: no history to predict from
    }

    IPTracker &t = trackers[index];
    touch_lru(index);

    // Stride in cache lines, from the truncated line addresses (wraps correctly
    // because the subtraction is done in LINE_ADDR_BITS-wide signed arithmetic).
    int32_t stride = (int32_t)((line - t.last_line) & LINE_MASK);
    if (stride >= (int32_t)(1u << (LINE_ADDR_BITS - 1))) stride -= (int32_t)(1u << LINE_ADDR_BITS);

    if (stride == 0)
        return;   // same line again: keep history and confidence untouched

    if (stride > DELTA_MAX || stride < DELTA_MIN) {
        // Jump too large to encode (and too large to ever stay inside the page):
        // the pattern, if any, is broken. Restart this IP's history from here.
        t.last_line = line;
        t.last_stride = 0;
        t.uniform_conf = 0;
        t.hist_count = 0;
        return;
    }

    // [REQ-4]/[HINT-1] Train the Pattern Table with the signature that was in effect
    // BEFORE this access, now that we know which stride really followed it.
    if (t.hist_count >= SIG_HIST_LEN)
        pt_train(compute_signature(t.ip_tag, t.delta_hist), (int8_t)stride);

    // [REQ-2]/[HINT-1] Uniform-stride confidence, updated on every access.
    if (stride == t.last_stride) {
        if (t.uniform_conf < UNIFORM_CONF_MAX) t.uniform_conf++;
    } else {
#if UNIFORM_RESET_ON_BREAK
        t.uniform_conf = 0;
#else
        if (t.uniform_conf > 0) t.uniform_conf--;
#endif
    }

    // Slide the stride window and look up the signature for THIS prediction
    for (int i = 0; i < SIG_HIST_LEN - 1; i++)
        t.delta_hist[i] = t.delta_hist[i + 1];
    t.delta_hist[SIG_HIST_LEN - 1] = (int8_t)stride;
    if (t.hist_count < SIG_HIST_LEN) t.hist_count++;

    // [REQ-3] Arbitration, decided separately for every prefetch of this access.
    //   * Uniform has priority: while this IP has a confirmed constant stride, the
    //     next line is predicted as "same stride again".
    //   * Dynamic fallback: before each step the Pattern Table is asked what follows
    //     the current stride sequence. If it is confident that a DIFFERENT stride
    //     follows (the "2,2,2 -> 3" point of a repeating pattern), this IP is not
    //     uniform here, and this step and all further steps use the non-uniform
    //     prediction instead.
    //   * If the constant stride is not confirmed at all, only the Pattern Table is used.
    bool have_sig     = (t.hist_count >= SIG_HIST_LEN);
    bool uniform_mode = (t.uniform_conf >= UNIFORM_CONF_THRESH);

    uint64_t chain_cl = cl_addr;                 // line the next prefetch is computed from
    int8_t   chain_hist[SIG_HIST_LEN];           // speculative copy of the stride window
    memcpy(chain_hist, t.delta_hist, sizeof(chain_hist));

    // [REQ-5] up to current_degree prefetches per access
    for (int i = 0; i < current_degree; i++) {
        int8_t  pt_delta = 0;
        uint8_t pt_conf = 0;
        bool    pt_hit = have_sig && pt_lookup(compute_signature(t.ip_tag, chain_hist), pt_delta, pt_conf);
        // the first step needs NONUNIFORM_CONF_THRESH, deeper (more speculative) steps need full confidence
        bool    pt_confident = pt_hit && pt_delta != 0
                               && (pt_conf >= (i == 0 ? NONUNIFORM_CONF_THRESH : CHAIN_CONF_THRESH));

        int8_t delta;
        if (uniform_mode && !(pt_confident && pt_delta != (int8_t)stride)) {
            delta = (int8_t)stride;              // uniform: same stride again
        } else if (pt_confident) {
            uniform_mode = false;                // fall back to the non-uniform predictor
            delta = pt_delta;
        } else {
            break;                               // neither predictor is confident: stop here
        }

        chain_cl += (int64_t)delta;
        uint64_t pf_addr = chain_cl << LOG2_BLOCK_SIZE;

        // [HINT-3] never leave the page of the triggering access
        if ((pf_addr >> LOG2_PAGE_SIZE) != (addr >> LOG2_PAGE_SIZE))
            break;

        // fill L1D while it has free miss buffers, otherwise only bring the line to L2
        int level = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
        stat_requests++;
        if (prefetch_line(ip, addr, pf_addr, level, 0)) {
            if (uniform_mode) stat_uniform_pf++; else stat_nonuniform_pf++;
        } else {
            stat_dropped++;
        }

        // push the predicted stride into the speculative window for the next step
        for (int k = 0; k < SIG_HIST_LEN - 1; k++)
            chain_hist[k] = chain_hist[k + 1];
        chain_hist[SIG_HIST_LEN - 1] = delta;
    }

    // commit state for the next access of this IP
    t.last_line   = line;
    t.last_stride = (int8_t)stride;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    // [REQ-6] A prefetched line has just been written into L1D. Remember it (by its
    // VIRTUAL line address, the same address space operate() sees) so that a later
    // demand hit on it is counted as a useful prefetch.
    if (prefetch) {
        pf_filter_mark(v_addr >> LOG2_BLOCK_SIZE);
        epoch_fills++;
        stat_fills++;
        evaluate_accuracy();
    }
}

void CACHE::l1d_prefetcher_final_stats()
{
    int lru_bits = 0;  while ((1 << lru_bits) < IP_TRACKER_COUNT) lru_bits++;        // log2(IP_TRACKER_COUNT)
    int hist_bits = 0; while ((1 << hist_bits) < SIG_HIST_LEN + 1) hist_bits++;      // counts 0..SIG_HIST_LEN
    int tracker_bits = 1 + IP_TAG_BITS + LINE_ADDR_BITS + DELTA_BITS + UNIFORM_CONF_BITS
                     + SIG_HIST_LEN * DELTA_BITS + hist_bits + lru_bits;
    int pt_bits      = 1 + PT_TAG_BITS + DELTA_BITS + PT_CONF_BITS;
    int filter_bits  = 1 + PF_TAG_BITS;
    int global_bits  = 9 + 9 + 3;   // epoch_fills, epoch_useful (count to 256), current_degree
    int total_bits   = IP_TRACKER_COUNT * tracker_bits + PT_SIZE * pt_bits
                     + PF_TRACK_SIZE * filter_bits + global_bits;

    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher final stats (whole run, warmup included)" << std::endl;
    std::cout << "SPP requests              : " << stat_requests << " (dropped, queue full: " << stat_dropped << ")" << std::endl;
    std::cout << "SPP uniform prefetches    : " << stat_uniform_pf << std::endl;
    std::cout << "SPP non-uniform prefetches: " << stat_nonuniform_pf << std::endl;
    std::cout << "SPP fills into L1D        : " << stat_fills << std::endl;
    std::cout << "SPP useful (own checker)  : " << stat_useful << std::endl;
    std::cout << "SPP accuracy (own checker): " << (stat_fills ? (100.0 * stat_useful / stat_fills) : 0.0) << " %" << std::endl;
    std::cout << "SPP accuracy epochs       : " << stat_epochs << "  epochs at degree";
    for (int d = MIN_PREFETCH_DEGREE; d <= MAX_PREFETCH_DEGREE; d++)
        std::cout << " " << d << ":" << stat_degree_epochs[d];
    std::cout << "  final degree: " << current_degree << std::endl;
    std::cout << "SPP storage: IP table " << IP_TRACKER_COUNT << " x " << tracker_bits << " b"
              << " + pattern table " << PT_SIZE << " x " << pt_bits << " b"
              << " + filter " << PF_TRACK_SIZE << " x " << filter_bits << " b"
              << " + globals " << global_bits << " b"
              << " = " << total_bits << " bits (" << (total_bits + 7) / 8 << " bytes)" << std::endl;
}
